{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["BridgeKit"],
  "ios": {
    "iosModuleName": "BridgeKit"
  },
  "android": {
    "androidNamespace": ["bridgekit"],
    "androidCxxLibName": "BridgeKit"
  },
  "autolinking": {
    "BridgeHost": {
      "ios": { "language": "swift", "implementationClassName": "HybridBridgeHost" },
      "android": { "language": "kotlin", "implementationClassName": "HybridBridgeHost" }
    },
    "BridgeStreams": {
      "ios": { "language": "swift", "implementationClassName": "HybridBridgeStreams" },
      "android": { "language": "kotlin", "implementationClassName": "HybridBridgeStreams" }
    },
    "BridgeState": {
      "ios": { "language": "swift", "implementationClassName": "HybridBridgeState" },
      "android": { "language": "kotlin", "implementationClassName": "HybridBridgeState" }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
